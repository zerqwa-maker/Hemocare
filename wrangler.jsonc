{
  "name": "hemocare",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
