  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hemocare-db",
      "database_id": "1d87ab3b-c3e2-434c-8aba-74a705f231e0"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
